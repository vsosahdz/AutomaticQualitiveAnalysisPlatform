# Copia este archivo a frontend/.env y ajusta según el despliegue.
# Vite solo expone al cliente las variables con prefijo VITE_.

# Base URL de la API del backend.
# - Desarrollo local (con el proxy de Vite): dejar "/api"
# - Backend local sin proxy:                 http://localhost:8000
# - Despliegue en la nube:                   https://tu-backend.ejemplo.com
VITE_API_BASE_URL=/api

# Intervalo de polling del progreso, en milisegundos.
VITE_POLL_INTERVAL_MS=1500
