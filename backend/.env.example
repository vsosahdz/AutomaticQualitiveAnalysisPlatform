# Copia este archivo a backend/.env y ajusta lo necesario.
# Todas las variables son opcionales; se muestran con sus valores por defecto.

# --- Proveedor de LLM: 'ollama' (local) | 'cloud' (futuro) ---
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2

# --- Ollama (proveedor local) ---
# Si se define y Ollama responde ahí, se usa DIRECTO. Si el puerto configurado lo
# ocupa otro servicio (p. ej. un chatbot en 11434), o si se deja comentado, los
# scripts autodetectan: prueban 11435 primero (puerto de despliegue) y luego 11434.
# Descoméntalo para forzar un host, p. ej.:
# OLLAMA_HOST=http://127.0.0.1:11435
# qwen2.5:14b = más preciso (recomendado); qwen2.5:latest (7b) = más rápido/ligero.
OLLAMA_MODEL=qwen2.5:14b

# --- Rendimiento de Ollama ---
# Contexto acotado (evita cargar el máximo del modelo, p. ej. 32K).
OLLAMA_NUM_CTX=8192
# Mantiene el modelo cargado entre llamadas (evita recargas).
OLLAMA_KEEP_ALIVE=30m
# Razonamiento (thinking) de modelos que lo soporten; false = más rápido.
OLLAMA_THINK=false

# --- LLM en la nube (proveedor futuro; dejar vacío por ahora) ---
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# --- Embeddings (comparación semántica, Fase II) ---
EMBEDDING_MODEL=bge-m3:latest
SEMANTIC_THRESHOLD=0.7

# --- Codebook ---
MAX_CUSTOM_CODES=3

# --- Segmentación / ventanas ---
WINDOW_CHARS=6000
WINDOW_OVERLAP=500

# --- CORS (orígenes permitidos, separados por coma) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
